<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rogue.Manager/Rogue.Manager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\libraries\EGL\libEGL-linux.so" Condition="$([System.OperatingSystem]::IsLinux())" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
